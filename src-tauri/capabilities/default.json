{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PPClip 默认权限：原生能力（剪贴板/截图/菜单/窗口）全部在 Rust 侧实现，前端只需要核心权限",
  "windows": ["ball", "main", "overlay", "pin-*", "viewer"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show"
  ]
}
